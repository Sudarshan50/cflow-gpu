# TEMPLATE for customers.tsv (gitignored - the real file holds live keys).
#
# Tab-separated: <customer-name><TAB>sk-k3-<name>-<40 hex>
# Do NOT hand-edit the real file; use the helpers so nginx is regenerated:
#
#     ./gen-keys.sh add <name>       mint a key and reload nginx
#     ./gen-keys.sh revoke <name>    remove a key and reload nginx
#     ./gen-keys.sh                  regenerate nginx from the file as-is
#
# The name becomes the identity in the access log (cust=<name>) and the key
# for the per-customer rate and concurrency zones, so it must be unique and
# should contain no tabs or whitespace.
# customer	api_key
# acme	sk-k3-acme-0000000000000000000000000000000000000000

# Env vars for the Kimi-K3 container. These CANNOT live in config.yaml -
# vLLM reads them from os.environ, while --config only ever produces argv.
#
# WARNING: AITER_SITUV2_A8W4 without AITER_BF16_FP8_MOE_BOUND=0 produces
# FLUENT BUT WRONG output at full speed. Never change one without the other,
# and always run /scratch/gate.sh afterwards.
VLLM_ROCM_USE_AITER=1
VLLM_ROCM_USE_AITER_MOE=1
AITER_SITUV2_A8W4=1
AITER_BF16_FP8_MOE_BOUND=0
VLLM_USE_BREAKABLE_CUDAGRAPH=0
SAFETENSORS_FAST_GPU=1
HF_HOME=/hf
HF_HUB_OFFLINE=1
VLLM_API_KEY=sk-k3-<redacted>

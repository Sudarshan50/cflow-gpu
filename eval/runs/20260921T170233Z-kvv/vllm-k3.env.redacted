VLLM_ROCM_USE_AITER=1
VLLM_ROCM_USE_AITER_MOE=1
# Left ON deliberately. fp8 KV would require VLLM_ROCM_USE_AITER_MLA=0,
# because the fp8 MLA path resolves to aiter/ops/triton/gluon/mla_gluon.py
# whose bh16bn128 variant asserts batch_size=1 ("requires batch_size=1, got
# 160" on every worker at profiling, 2026-09-20 17:14). fp8 was rejected on
# throughput anyway, so the AITER MLA kernel stays.
AITER_SITUV2_A8W4=1
AITER_BF16_FP8_MOE_BOUND=0
VLLM_USE_BREAKABLE_CUDAGRAPH=0
SAFETENSORS_FAST_GPU=1
HF_HOME=/hf
HF_HUB_OFFLINE=1
PYTHONHASHSEED=0
PYTHONUNBUFFERED=1

# ---------------------------------------------------------------------------
# SECRETS. Nothing in this section may ever be committed.
#
# Each of these is a live credential on a running box. The repo ships a
# *.example twin for every one of them; deploy.sh generates the real file.
# Verify with `make secret-scan` before every push.
# ---------------------------------------------------------------------------

# Upstream vLLM credential (VLLM_API_KEY) in cleartext.
api-key.txt

# nginx basic-auth password for the :8080 dashboard, cleartext.
dash-password.txt

# Every live per-customer API key, cleartext, tab-separated.
customers.tsv

# Contains VLLM_API_KEY alongside the (non-secret) AITER tuning flags.
# Committed form is vllm-k3.env.example.
vllm-k3.env

# Generated nginx fragments. 00-k3-keys.conf embeds every customer key and
# k3-limits.inc embeds the upstream key. gen-keys.sh rebuilds both.
nginx/00-k3-keys.conf
nginx/k3-limits.inc
*.htpasswd

# Anything a future script drops in here.
secrets/
*.pem
*.key
!**/*.pub

# ---------------------------------------------------------------------------
# Machine-local state. Correct on the box, meaningless in the repo.
# ---------------------------------------------------------------------------

# Timestamped config snapshots left by hand-edits (config.yaml.bak-12800 etc).
*.bak
*.bak-*
*.pre-tls.bak

# Multi-gigabyte docker image export consumed by launch.sh.
backup/
*.tar
*.tar.zst

# Benchmark output; regenerated by the gate and the test scripts.
results/
*.jsonl

__pycache__/
*.py[cod]
.venv/
venv/

.DS_Store
*.swp

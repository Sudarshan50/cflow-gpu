FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3.12 python3.12-venv libpython3.12 ca-certificates curl \
  && ln -sf /usr/bin/python3.12 /usr/bin/python3 \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /usr/local/lib/k3
ENV PYTHONPATH=/usr/local/lib/k3 PYTHONUNBUFFERED=1

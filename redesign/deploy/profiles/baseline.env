# Profile: baseline -- the G-build configuration.
#
# Stands the stack up with NO capacity optimisation enabled. This is the config
# that must serve correctly and record a gate baseline before anything is
# tuned, and it is the config to snapshot.
#
# Expected KV pool: ~2.3M tokens (MLA replicated 8x under TP=8).
# See docs/SYSTEM-DESIGN.md 2.

PROFILE_NAME=baseline

# --- Parallelism -------------------------------------------------------------
# 1.5 TB of MXFP4 weights across 8x288 GB. TP=8 is forced; nothing smaller fits.
TP_SIZE=8

# A1 disabled. Enabling it is the entire point of session G2, and it must be
# measured against this profile's numbers.
ENABLE_DP_ATTENTION=0
DP_SIZE=1

# --- KV ----------------------------------------------------------------------
# A2 disabled. fp8 KV fails as silent garbage, so it is gated on the extended
# correctness gate (Z5), not on a throughput number.
KV_CACHE_DTYPE=auto

# A3 disabled. Host tiering is a fallback if A1 proves unavailable; it addresses
# hit rate, not concurrency.
ENABLE_HIERARCHICAL_CACHE=0
HICACHE_RATIO=

# --- Admission (B1) ----------------------------------------------------------
# Left empty on purpose: deploy.sh computes it from redesign.capacity so the
# ceiling always matches the pool this profile actually produces. Set a value
# here only to override the model.
MAX_RUNNING_REQUESTS=

# --- Shapes ------------------------------------------------------------------
# The context window includes input and generated output.
MAX_MODEL_LEN=262144

# B3. Caps one long prefill's share of the scheduling budget.
LONG_PREFILL_THRESHOLD=32768

# B2. Without this the engine schedules FCFS and every class the gateway
# assigns is inert -- P3 distillation competes evenly with P0 keystrokes.
# deploy.sh validates the flag against the image and only tells the gateway to
# stamp a priority once the engine is known to accept one.
ENABLE_PRIORITY_SCHEDULING=1

# C2. Prefill chunk size. The old 8192 was tuned against a 12.8k-prompt
# benchmark; the observed mean is ~31k, so this is almost certainly mis-sized.
# Treat the value as a starting point to sweep, not as a tuned constant.
MAX_NUM_BATCHED_TOKENS=16384

# --- Compute (C1) ------------------------------------------------------------
# The AITER contract moved between builds. Carrying an env file forward verbatim
# is the documented way to recreate the silent-garbage failure, so these are
# named explicitly and validated against the image's own CLI/env surface.
SGLANG_USE_AITER=1
SGLANG_AITER_K3_OPT=1
AITER_FLYDSL_FORCE=1
AITER_SITUV2_A8W4=1

LANGUAGE_MODEL_ONLY=0
MEM_FRACTION_STATIC=0.99
CUDA_GRAPH_MAX_BS_DECODE=16
MAMBA_SSM_DTYPE=bfloat16
DISABLE_CUDA_GRAPH=1

# Mandatory at TP>1: without a stable hash seed the cache keys differ per worker
# and any KV reuse silently never hits.
PYTHONHASHSEED=0

# --- Not enabled -------------------------------------------------------------
# Speculative decoding requires a separate workload-matched qualification.
ENABLE_DSPARK=0

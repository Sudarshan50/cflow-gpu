# DO NOT APPLY ON THIS BOX. G4/A3 read-path FAIL 2026-09-20 (CPU→GPU 0).
# Profile: dedup-hicache -- session G4. A3 on top of A1.
#
# Adds a host-DRAM L2 tier (HiCache) on top of de-duplication. A3 raises the
# cache HIT RATE, not resident concurrency, so it is measured on hit rate and
# TTFT -- not on pool size, which is unchanged from the dedup profile.
#
# Run this only if A1 and A2 leave KV still binding. If the pool is already
# 16x, a PCIe round trip on every miss is a regression, not an optimisation.
#
# hicache-ratio 2.0 sizes the host pool at 2x the device pool. Ramp it; the
# equivalent vLLM connector is documented to crash above 64 GB, and there is no
# reason to assume this one is unconditionally safe at 1.75 TB either.

PROFILE_NAME=dedup-hicache

TP_SIZE=8

# A1 ON. dp_size matches tp_size so every rank owns a slice of the sequences
# rather than a copy of every sequence's KV.
ENABLE_DP_ATTENTION=1
DP_SIZE=8

KV_CACHE_DTYPE=auto

ENABLE_HIERARCHICAL_CACHE=1
HICACHE_RATIO=2.0

# HAZARD: --max-running-requests is server-wide and floor-divided by dp_size.
# Set it too low and the per-rank share drops below the hybrid state pool's
# minimum, and the server refuses everything while looking like a migration
# failure. deploy.sh computes the server-wide figure and refuses to launch if
# the post-division value is implausible.
MAX_RUNNING_REQUESTS=

MAX_MODEL_LEN=262144
LONG_PREFILL_THRESHOLD=32768

# B2. Without this the engine schedules FCFS and every class the gateway
# assigns is inert -- P3 distillation competes evenly with P0 keystrokes.
# deploy.sh validates the flag against the image and only tells the gateway to
# stamp a priority once the engine is known to accept one.
ENABLE_PRIORITY_SCHEDULING=1

# C2. Prefill chunk size. The old 8192 was tuned against a 12.8k-prompt
# benchmark; the observed mean is ~31k, so this is almost certainly mis-sized.
# Treat the value as a starting point to sweep, not as a tuned constant.
MAX_NUM_BATCHED_TOKENS=16384

SGLANG_USE_AITER=1
SGLANG_AITER_K3_OPT=1
AITER_FLYDSL_FORCE=1
AITER_SITUV2_A8W4=1
PYTHONHASHSEED=0

LANGUAGE_MODEL_ONLY=0
MEM_FRACTION_STATIC=0.99
CUDA_GRAPH_MAX_BS_DECODE=16
MAMBA_SSM_DTYPE=bfloat16
DISABLE_CUDA_GRAPH=1

# Prefill CP cannot be combined with DP attention: --cp-strategy interleave
# asserts dp_size == 1. DP attention is the one that de-duplicates resident KV,
# which is the binding constraint, so it wins.
ENABLE_PREFILL_CP=0

ENABLE_DSPARK=0

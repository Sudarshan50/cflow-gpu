# Profile: dedup-fp8 -- session G3. Stacks A2 on top of A1.
#
# Expected KV pool ~37.9M tokens, ~16x baseline. At that point KV stops being
# the binding constraint and prefill compute binds instead.
#
# CORRECTNESS GATE IS MANDATORY BEFORE THIS SEES CUSTOMER TRAFFIC.
# Quantised KV fails as silent garbage: output stays fluent and becomes wrong,
# which every throughput benchmark reports as a success. Z5 exists for this.

PROFILE_NAME=dedup-fp8

TP_SIZE=8

ENABLE_DP_ATTENTION=1
DP_SIZE=8

# A2 ON.
KV_CACHE_DTYPE=fp8_e4m3

ENABLE_HIERARCHICAL_CACHE=0
HICACHE_RATIO=

MAX_RUNNING_REQUESTS=

MAX_MODEL_LEN=262144
LONG_PREFILL_THRESHOLD=32768

SGLANG_USE_AITER=1
SGLANG_AITER_K3_OPT=1
AITER_FLYDSL_FORCE=1
AITER_SITUV2_A8W4=1
PYTHONHASHSEED=0

ENABLE_PREFILL_CP=0
ENABLE_DSPARK=0

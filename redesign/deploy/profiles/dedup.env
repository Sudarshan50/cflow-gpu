# Profile: dedup -- session G2. The main event.
#
# Enables A1: DP attention partitions the MLA latent by sequence instead of
# replicating it per rank. Expected KV pool ~18.9M tokens, an ~8x increase.
#
# Pass/fail for G2: pool grows materially, correctness gate passes, and P0 TTFT
# p95 does NOT regress. DP attention is a throughput optimisation; if it buys
# capacity at the cost of interactive latency, that is the tradeoff appearing
# and it is the one thing that could make A1 not worth taking.

PROFILE_NAME=dedup

TP_SIZE=8

# A1 ON. dp_size matches tp_size so every rank owns a slice of the sequences
# rather than a copy of every sequence's KV.
ENABLE_DP_ATTENTION=1
DP_SIZE=8

KV_CACHE_DTYPE=auto

ENABLE_HIERARCHICAL_CACHE=0
HICACHE_RATIO=

# HAZARD: --max-running-requests is server-wide and floor-divided by dp_size.
# Set it too low and the per-rank share drops below the hybrid state pool's
# minimum, and the server refuses everything while looking like a migration
# failure. deploy.sh computes the server-wide figure and refuses to launch if
# the post-division value is implausible.
MAX_RUNNING_REQUESTS=

MAX_MODEL_LEN=262144
LONG_PREFILL_THRESHOLD=32768

SGLANG_USE_AITER=1
SGLANG_AITER_K3_OPT=1
AITER_FLYDSL_FORCE=1
AITER_SITUV2_A8W4=1
PYTHONHASHSEED=0

# Prefill CP cannot be combined with DP attention: --cp-strategy interleave
# asserts dp_size == 1. DP attention is the one that de-duplicates resident KV,
# which is the binding constraint, so it wins.
ENABLE_PREFILL_CP=0

ENABLE_DSPARK=0

[Unit]
Description=Kimi-K3 LiteLLM tenancy layer
After=docker.service k3-gateway.service k3-litellm-db.service k3-litellm-redis.service
Wants=k3-gateway.service k3-litellm-db.service k3-litellm-redis.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/usr/local/lib/k3
Environment=K3_REPO_ROOT=/usr/local/lib/k3
Environment=K3_MAX_MODEL_LEN=262144
Environment=K3_LITELLM_WORKERS=32
Environment=K3_LITELLM_CONFIG=/scratch/deploy-state/litellm.yaml
Environment=STORE_MODEL_IN_DB=True
Environment=HOME=/scratch/litellm-home
Environment=XDG_CACHE_HOME=/scratch/litellm-home/.cache
EnvironmentFile=-/scratch/deploy/offbox.env
EnvironmentFile=-/scratch/deploy/litellm.env
ExecStartPre=-/usr/bin/docker rm -f k3-litellm
ExecStart=/usr/local/lib/k3/redesign/deploy/containers/run.sh k3-litellm \
  /usr/local/lib/k3/redesign/deploy/litellm/start.sh
ExecStop=/usr/bin/docker stop -t 20 k3-litellm
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

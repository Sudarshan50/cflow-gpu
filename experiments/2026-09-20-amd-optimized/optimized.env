# Shared by both candidates. AMD worker's complete GPU/kernel environment block:
# AMD-AGI/Infera@625a950b109371aaf8ebedfdc05757b57ac32eab
# examples/recipes/kimi-k3-optimized/aggregated/deploy.yaml
VLLM_ROCM_USE_AITER=1
VLLM_ROCM_USE_AITER_FP4BMM=1
AITER_SITUV2_A8W4=1
AITER_BF16_FP8_MOE_BOUND=0
HIP_FORCE_DEV_KERNARG=1
HSA_NO_SCRATCH_RECLAIM=1
HSA_ENABLE_IPC_MODE_LEGACY=1
SAFETENSORS_FAST_GPU=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_ENABLE_K3_LATENT_MOE_TAIL_FUSION=1
VLLM_ROCM_USE_KIMI_K3_PREROUTE_BF16=0
VLLM_ROCM_USE_KIMI_K3_PREROUTE_FP8=1
VLLM_ROCM_USE_KIMI_K3_LATENT_TAIL_FP8=1
KIMI_K3_DUAL_PROJ_FP8_WEIGHT_CACHE_MODIFIER=2
KIMI_K3_SHARED_DOWN_FP8_WEIGHT_CACHE_MODIFIER=2

# Local offline model-cache contract. Credentials are supplied separately.
HF_HOME=/hf
HF_HUB_OFFLINE=1

# Startup-only cache, specific to this image; populated from the qualified base.
# Does not change the kernel selection or sampling configuration.
AITER_JIT_DIR=/root/.cache/aiter-5f3007

# =============================================================================
# TEMPLATE - NOT LOADED BY NGINX.
#
# This file documents the live TLS edge, `/etc/nginx/conf.d/k3-tls.conf`.
# nginx.conf includes `/etc/nginx/conf.d/*.conf` (nginx.conf:59), so the
# `.template` suffix keeps this copy inert even if it is placed in conf.d.
#
# SOURCE OF TRUTH: `issue-cert.sh`, function `write_tls_server()`
# (issue-cert.sh:37-112). The live file is generated by that heredoc at cert
# issuance time and is therefore deliberately NOT committed as a static file.
# If you change edge policy, change `write_tls_server()` first, then mirror it
# here. Editing this file alone changes nothing.
#
# WHY COMMIT A TEMPLATE AT ALL: the generated file is the entire public
# authorization boundary, and without a committed copy the policy is invisible
# to code review and unreconstructable if the script fails.
#
# PLACEHOLDERS, and where the generator gets each value:
#   __DOMAIN__       <- DOMAIN, hardcoded at issue-cert.sh:11 (cflox.store).
#   __WWW_SUFFIX__   <- WWW_SUFFIX, computed at issue-cert.sh:38-39: the string
#                       " www.__DOMAIN__" (note the LEADING SPACE) when
#                       WWW_OK=1, and the empty string otherwise. issue() sets
#                       WWW_OK=0 (issue-cert.sh:127) when the www name fails
#                       HTTP-01, so nginx does not claim a name it cannot
#                       serve. Both placeholders are concatenated directly in
#                       `server_name`, so substitution is a plain textual
#                       replace:
#                         sed -e 's/__DOMAIN__/cflox.store/g' \
#                             -e 's/__WWW_SUFFIX__/ www.cflox.store/' this file
#                       (use an empty replacement for the second when there is
#                       no www record).
#
# HAND-INSTALLING THIS FILE: the certificate must ALREADY EXIST. `nginx -t`
# fails on a missing `ssl_certificate`, which is exactly why
# `write_tls_server()` is only called after certbot succeeds and after
# `/etc/letsencrypt/live/__DOMAIN__/fullchain.pem` is confirmed non-empty
# (issue-cert.sh:40, issue-cert.sh:130-134). Run `nginx -t` before any reload;
# `issue()` rolls back to `${TLSCONF}.pre-tls.bak` if the test fails
# (issue-cert.sh:133-138).
#
# ESCAPING: the generator's heredoc is quoted-expansion, so inside
# `issue-cert.sh` every nginx variable is written `\$host`, `\$remote_addr`,
# `\$k3_customer`. This file is NOT passed through a shell, so those appear
# here in their real form (`$host`, ...). Do not copy the backslashes across in
# either direction.
#
# THIS BLOCK IS INTENTIONALLY AUTH-FREE AND ZONE-FREE. It references
# `$k3_customer`, the `k3_percust`/`k3_rps`/`k3_global` zones and the `k3usage`
# log format, but defines none of them: they all live in
# `/etc/nginx/conf.d/00-k3-keys.conf`, generated by `gen-keys.sh`
# (gen-keys.sh:66-94). Consequences, in the generator's own words
# (issue-cert.sh:41-42):
#   - adding or revoking a customer never touches this file;
#   - redeclaring `map_hash_bucket_size` here fails `nginx -t` as a duplicate.
# The `k3_backend` / `k3_dash` upstreams come from `nginx/k3.conf`.
#
# VERIFIED AGAINST THE LIVE FILE (2026-09-18): every directive below is
# byte-identical to `/etc/nginx/conf.d/k3-tls.conf` after placeholder
# substitution. The live file carries a few extra explanatory COMMENTS that
# `write_tls_server()` does not emit; see docs/ARCHITECTURE.md "Discrepancies".
# =============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN____WWW_SUFFIX__;
    location /.well-known/acme-challenge/ { root /var/www/certbot; access_log off; }
    location / { return 301 https://$host$request_uri; }
}

server {
    # nginx 1.24 rejects the standalone "http2 on;" added in 1.25.1.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN____WWW_SUFFIX__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 256m;
    client_body_buffer_size 1m;

    # Same allowlist as the :8000 edge. vLLM's --api-key only guards
    # ("/v1","/v2","/inference"), leaving POST /invocations (verified 200 with
    # no credentials) and /scale_elastic_ep open. This is what closes them.
    location = /metrics { allow 127.0.0.1; deny all; access_log off; proxy_pass http://k3_backend; }
    location = /health  { allow 127.0.0.1; deny all; access_log off; proxy_pass http://k3_backend; }

    location /v1/ {
        if ($k3_customer = "") { return 401 '{"error":{"message":"invalid or missing api key","type":"authentication_error"}}'; }
        default_type application/json;
        include /etc/nginx/conf.d/k3-limits.inc;
        access_log /var/log/nginx/k3-usage.log k3usage;

        proxy_pass http://k3_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 12k-in/512-out runs ~112s; the 60s default would cut streams off.
        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }

    error_page 429 = @throttled;
    location @throttled {
        add_header Retry-After 2 always;
        default_type application/json;
        return 429 '{"error":{"message":"rate limit exceeded for this api key","type":"rate_limit_error","code":429}}';
    }

    error_page 413 = @too_large;
    location @too_large {
        default_type application/json;
        return 413 '{"error":{"message":"request body exceeds 256 MB; send a smaller image or pass an image_url instead of base64","type":"invalid_request_error","code":413}}';
    }

    include /etc/nginx/conf.d/k3-dash.inc;

    location / { return 403 '{"error":{"message":"forbidden","type":"invalid_request_error"}}'; default_type application/json; }
}

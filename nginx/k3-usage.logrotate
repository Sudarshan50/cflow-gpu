# Retention for the per-customer usage log, the billing record.
# Installed by deploy.sh to /etc/logrotate.d/k3-usage.
#
# Do not move this back under /var/log/nginx/: the nginx package globs that
# directory at `rotate 14`, and logrotate has no exclude syntax, so these
# settings would be silently overridden and the billing record dropped after
# two weeks.
/var/log/k3/*.log {
    daily
    rotate 365
    compress
    delaycompress
    missingok
    notifempty
    # root-only: the worker writes via a descriptor the master opens, so
    # www-data needs no access.
    create 0640 root adm
    su root adm
    sharedscripts
    postrotate
        # nginx keeps writing to the renamed file until told to reopen.
        invoke-rc.d nginx rotate >/dev/null 2>&1 || true
    endscript
}
